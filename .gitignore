.venv/
__pycache__/
*.egg-info/
.pytest_cache/
external/
*.partial

# The GPU-hour ledger is versioned; run outputs, checkpoints and lock files stay local.
runs/*
!runs/gpu-ledger.json

# Keep only the frozen study artifacts needed to reproduce the handoff.
artifacts/*
!artifacts/graphs/
artifacts/graphs/*
!artifacts/graphs/real.json
!artifacts/graphs/real.npz
!artifacts/power/
artifacts/power/*
!artifacts/power/final-grid.jsonl
!artifacts/power/final-grid.meta.json
!artifacts/power/extended-grid-v5.1.jsonl
!artifacts/power/extended-grid-v5.1.meta.json
!artifacts/power/fwer-official-v5.1.jsonl
!artifacts/power/fwer-official-v5.1.meta.json
!artifacts/power/fwer-official-v5.1.jsonl.started
!artifacts/tokenizer-v4.3.json
!artifacts/tokenizer-v4.3.meta.json
!artifacts/tokenizer-v4.4.json
!artifacts/tokenizer-v4.4.meta.json
!artifacts/tokenizer-wordbound-v1.json
!artifacts/tokenizer-wordbound-v1.meta.json
!artifacts/tokenizer-wordbound-v4.4.json
!artifacts/tokenizer-wordbound-v4.4.meta.json
!artifacts/tokenizer-wordbound-v4.5.json
!artifacts/tokenizer-wordbound-v4.5.meta.json
!artifacts/tokenizer-wordbound-v4.6.json
!artifacts/tokenizer-wordbound-v4.6.meta.json
!artifacts/tokenizer-wordbound-v4.7.json
!artifacts/tokenizer-wordbound-v4.7.meta.json

# Earlier drafts remain local. Only the reviewed-candidate version is published.
data/*
!data/draft-v4.3/
!data/draft-v4.4/
!data/draft-v4.5/
!data/draft-v4.6/
!data/draft-v4.7/

# Human review: blinded distribution packages are published; the review-id mapping,
# reviewer registry and returned judgments never leave the operator.
review/private/
review/submissions/
review/ai/

# Protocol v5 review workspace (private mapping, raw Claude responses, evidence) stays out of the repository.
review/v5/
review/v6/
review/v7/

# Main-study analysis: only analysis.json is published; 800 per-run figures and forgetting records stay local.
reports/main-v5.1-analysis/*
!reports/main-v5.1-analysis/analysis.json
